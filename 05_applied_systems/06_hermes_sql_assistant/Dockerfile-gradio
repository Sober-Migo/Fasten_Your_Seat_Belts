FROM python:3.12-slim

WORKDIR /app

COPY 01_hermes_sql_agent/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY 01_hermes_sql_agent/app /app/app
COPY app/gradio_ui.py /app/gradio_ui.py
COPY 01_hermes_sql_agent/database /app/database
COPY 01_hermes_sql_agent/skills /app/skills

EXPOSE 7860

CMD ["python", "gradio_ui.py"]
